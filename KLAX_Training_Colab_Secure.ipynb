        "print('CUDA:', torch.cuda.is_available())",
        "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!pip install -q libsql-client pandas numpy scikit-learn python-metar"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import pandas as pd",
        "import numpy as np",
        "import torch",
        "import torch.nn as nn",
        "from sklearn.model_selection import train_test_split",
        "from sklearn.preprocessing import StandardScaler",
        "import pickle",
        "import asyncio",
        "import time",
        "import os",
        "",
        "EPOCHS = 2000",
        "BATCH_SIZE = 64",
        "LEARNING_RATE = 0.0005",
        "PATIENCE = 100",",
        "",
        "class GPUTransformer(nn.Module):",
        "    def __init__(self, input_dim, model_dim=128, nhead=8, num_layers=4, dropout=0.2):",
        "        super().__init__()",
        "        self.input_proj = nn.Linear(input_dim, model_dim)",
        "        encoder_layer = nn.TransformerEncoderLayer(d_model=model_dim, nhead=nhead, dim_feedforward=512, dropout=dropout, batch_first=True)",
        "        self.transformer = nn.TransformerEncoder(encoder_layer, num_layers=num_layers)",
        "        self.output_proj = nn.Sequential(nn.Linear(model_dim, 64), nn.ReLU(), nn.Dropout(dropout), nn.Linear(64, 1))",
        "    def forward(self, x):",
        "        x = self.input_proj(x)",
        "        x = self.transformer(x)",
        "        x = x.mean(dim=1)",
        "        return self.output_proj(x).squeeze(-1)",
        "",
        "async def load_data():",
        "    import libsql_client",
        "    DB_URL = os.getenv('TURSO_DATABASE_URL')",
        "    AUTH_TOKEN = os.getenv('TURSO_AUTH_TOKEN')",
        "    async with libsql_client.create_client(url=DB_URL, auth_token=AUTH_TOKEN) as client:",
        "        rs_nowcast = await client.execute('SELECT * FROM historical_nowcast_features ORDER BY DATE')",
        "        rs_marine = await client.execute('SELECT * FROM historical_marine_features ORDER BY DATE')",
        "        rs_cli = await client.execute('SELECT * FROM historical_cli_reports ORDER BY DATE')",
        "        nowcast_df = pd.DataFrame(rs_nowcast.rows, columns=[c for c in rs_nowcast.columns])",
        "        marine_df = pd.DataFrame(rs_marine.rows, columns=[c for c in rs_marine.columns])",
        "        cli_df = pd.DataFrame(rs_cli.rows, columns=[c for c in rs_cli.columns])",
        "    print(f'Loaded: {len(nowcast_df)} nowcast, {len(marine_df)} marine, {len(cli_df)} CLI')",
        "    return nowcast_df, marine_df, cli_df",
        "",
        "def prepare_data(nowcast_df, marine_df, cli_df):",
        "    nowcast_df['DATE'] = pd.to_datetime(nowcast_df['DATE'])",
        "    marine_df['DATE'] = pd.to_datetime(marine_df['DATE'])",
        "    cli_df['DATE'] = pd.to_datetime(cli_df['DATE'])",
        "    if 'dewpoint_spread_5am' in nowcast_df.columns:",
        "        nowcast_df = nowcast_df.drop(columns=['dewpoint_spread_5am'])",
        "    df = pd.merge(cli_df, nowcast_df, on='DATE', how='inner')",
        "    df = pd.merge(df, marine_df, on='DATE', how='inner')",
        "    features = ['avg_wind_speed_6h', 'avg_wind_direction_6h', 'morning_cloud_cover_avg', 'ceiling_slope', 'temp_slope_7_10am', 'sun_flag_8am', 'dewpoint_spread_5am']",
        "    df = df.dropna(subset=features + ['tmax_cli_f'])",
        "    print(f'Records: {len(df)}')",
        "    return df[features].values, df['tmax_cli_f'].values",
        "",
        "def create_sequences(X, y, seq_len=14):",
        "    X_seq, y_seq = [], []",
        "    for i in range(len(X) - seq_len):",
        "        X_seq.append(X[i:i+seq_len])",
        "        y_seq.append(y[i+seq_len])",
        "    return np.array(X_seq), np.array(y_seq)",
        "",
        "async def train():",
        "    print('Starting training...')",
        "    nowcast_df, marine_df, cli_df = await load_data()",
        "    X, y, _ = prepare_data(nowcast_df, marine_df, cli_df)",
        "    X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, shuffle=False)",
        "    scaler = StandardScaler()",
        "    X_train_scaled = scaler.fit_transform(X_train)",
        "    X_test_scaled = scaler.transform(X_test)",
        "    os.makedirs('model', exist_ok=True)",
        "    with open('model/klax_scaler_gpu.pkl', 'wb') as f:",
        "        pickle.dump(scaler, f)",
        "    X_train_seq, y_train_seq = create_sequences(X_train_scaled, y_train)",
        "    X_test_seq, y_test_seq = create_sequences(X_test_scaled, y_test)",
        "    model = GPUTransformer(7, dropout=0.2).to(device)",
        "    X_train_t = torch.from_numpy(X_train_seq).float().to(device)",
        "    y_train_t = torch.from_numpy(y_train_seq).float().to(device)",
        "    X_test_t = torch.from_numpy(X_test_seq).float().to(device)",
        "    y_test_t = torch.from_numpy(y_test_seq).float().to(device)",
        "    criterion = nn.MSELoss()",
        "    optimizer = torch.optim.AdamW(model.parameters(), lr=LEARNING_RATE, weight_decay=0.01)",
        "    scheduler = torch.optim.lr_scheduler.CosineAnnealingWarmRestarts(optimizer, T_0=50, T_mult=2)",
        "    best_mae = float('inf')",
        "    epochs_no_improve = 0",
        "    start_time = time.time()",
        "    for epoch in range(EPOCHS):",
        "        total_loss = 0",
        "        for i in range(0, len(X_train_t), BATCH_SIZE):",
        "            batch_x = X_train_t[i:i+BATCH_SIZE]",
        "            batch_y = y_train_t[i:i+BATCH_SIZE]",
        "            optimizer.zero_grad()",
        "            outputs = model(batch_x)",
        "            loss = criterion(outputs, batch_y)",
        "            loss.backward()",
        "            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)",
        "            optimizer.step()",
        "            scheduler.step(epoch + i / len(X_train_t))",
        "            total_loss += loss.item()",
        "        model.eval()",
        "        with torch.no_grad():",
        "            test_pred = model(X_test_t)",
        "            test_mae = torch.mean(torch.abs(test_pred - y_test_t)).item()",
        "        model.train()",
        "        if test_mae < best_mae - 0.01:",
        "            best_mae = test_mae",
        "            epochs_no_improve = 0",
        "            torch.save(model.state_dict(), 'model/klax_transformer_gpu_best.pth')",
        "        else:",
        "            epochs_no_improve += 1",
        "        if (epoch + 1) % 20 == 0:",
        "            print(f'Epoch {epoch+1}: loss={total_loss:.2f}, mae={test_mae:.2f}F, best={best_mae:.2f}F')",
        "        if epochs_no_improve >= PATIENCE:",
        "            print(f'Early stop at epoch {epoch+1}')",
        "            break",
        "    print(f'Training done in {(time.time()-start_time)/60:.1f}min')",
        "    print(f'Best MAE: {best_mae:.2f}F')",
        "    torch.save(model.state_dict(), 'model/klax_transformer_gpu_final.pth')",
        "    print('Models saved')",
        "",
        "await train()"
      ]
    },
    {
      "cell_type": "code",
