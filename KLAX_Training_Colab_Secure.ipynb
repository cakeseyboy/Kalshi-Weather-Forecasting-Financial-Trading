      "outputs": [],
      "source": [
        "from google.colab import userdata",
        "import os",
        "TURSO_AUTH_TOKEN = userdata.get('TURSO_AUTH_TOKEN')",
        "TURSO_DATABASE_URL = 'https://marlinmodel-cakeseyboy.aws-us-east-1.turso.io'",
